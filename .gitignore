# Сборка
.gradle/
build/
app/build/
dist/

# Локальные настройки
local.properties
*.iml
.idea/

# Ключи подписи. В репозитории хранится ТОЛЬКО постоянный ключ
# signing/release.p12 — он зашифрован паролем владельца (секрет GitHub).
# Любые другие файлы ключей сюда попадать не должны.
*.p12
*.jks
*.keystore
signing/*
!signing/release.p12

# Системное
.DS_Store
