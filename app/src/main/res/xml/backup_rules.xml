<?xml version="1.0" encoding="utf-8"?>
<!--
  Для Android 11 и старше: исключаем всё из резервного копирования.
  Вместе с allowBackup="false" гарантирует, что данные не уходят в облако.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
