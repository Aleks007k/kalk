<?xml version="1.0" encoding="utf-8"?>
<!--
  Полный запрет на выгрузку данных приложения: ни в облачную резервную копию,
  ни при переносе на другое устройство. Данные тайника никогда не покидают телефон.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
